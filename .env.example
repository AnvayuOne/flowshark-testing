# Add these in Vercel → Project → Settings → Environment Variables.
# For local development copy this file to .env.local.

# Vercel Postgres (Neon). Added automatically when you connect the database
# to the project in Vercel → Storage.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Random secret for signing login sessions (32+ characters).
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Your site's public address (used in verification and reset emails).
APP_URL=https://your-project.vercel.app

# Company mailbox used to send verification / reset emails.
# Google Workspace: smtp.gmail.com, port 465, user = the mailbox, pass = an App Password
# Microsoft 365:    smtp.office365.com, port 587, user = the mailbox, pass = its password (SMTP AUTH enabled)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=noreply@anvayuone.com
SMTP_PASS=
SMTP_FROM=Anvayu Test Tracker <noreply@anvayuone.com>

# Optional: comma-separated emails that always become Admin when they verify.
# (Otherwise the first person to verify becomes Admin.)
ADMIN_EMAILS=
